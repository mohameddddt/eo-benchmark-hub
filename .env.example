# Copy to .env — docker compose reads this file automatically
POSTGRES_USER=eobench
POSTGRES_PASSWORD=eobench-dev-password
POSTGRES_DB=eobench
DATABASE_URL=postgresql+psycopg2://eobench:eobench-dev-password@postgres:5432/eobench
REDIS_URL=redis://redis:6379/0
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=1440
STORAGE_DIR=/data/storage
GROUND_TRUTH_DIR=/data/ground_truth
AUTO_CREATE_TABLES=true
WEEKLY_QUOTA=20
