# Only needed for `docker compose up` (the default local setup needs no .env).
POSTGRES_USER=eobench
POSTGRES_PASSWORD=eobench-dev-password
POSTGRES_DB=eobench
DATABASE_URL=postgresql+psycopg2://eobench:eobench-dev-password@postgres:5432/eobench
REDIS_URL=redis://redis:6379/0
JWT_SECRET=change-me-to-a-long-random-string
WEEKLY_QUOTA=20
